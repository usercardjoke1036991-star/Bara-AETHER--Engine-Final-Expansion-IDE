{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bara IDE",
  "mainBinaryName": "bara-ide-desktop",
  "version": "0.1.0",
  "identifier": "com.aetheromega.bara.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bara IDE — AETHER-Ω",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "AETHER-Ω",
    "category": "DeveloperTool",
    "shortDescription": "IDE del lenguaje Bara (Shoresh)",
    "longDescription": "IDE de escritorio para el lenguaje Bara (AETHER-Ω): analiza documentos Shoresh con el kernel congelado v0.1.0-kernel."
  }
}
