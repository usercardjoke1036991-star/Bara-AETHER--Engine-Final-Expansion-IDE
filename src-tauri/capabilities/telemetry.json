{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "telemetry",
  "description": "Cockpit de telemetría: manifiesto, marco, caja negra y reposo",
  "windows": ["telemetry"],
  "permissions": [
    "core:default",
    "allow-get-system-manifest",
    "allow-get-neural-frame",
    "allow-get-flight-recorder-logs",
