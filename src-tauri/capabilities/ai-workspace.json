{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai-workspace",
  "description": "Asistencia multimodal: chat, llavero, carpeta de contexto y medios",
  "windows": ["ai-workspace"],
  "permissions": [
    "core:default",
    "llavero",
    "medios",
    "allow-workspace-roots",
    "allow-workspace-tree",
    "allow-workspace-read-document",
    "allow-workspace-write-document",
    "allow-workspace-open-dialog",
    "allow-workspace-activate",
    "allow-workspace-close-root",
    "allow-shoresh-translate",
    "allow-load-local-weights",
    "allow-local-complete"
  ]
}
