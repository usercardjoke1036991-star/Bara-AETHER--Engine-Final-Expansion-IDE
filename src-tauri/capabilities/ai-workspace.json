{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai-workspace",
  "description": "Asistencia: contexto, catálogo y medios. Sin llavero ni llamada al modelo.",
  "windows": ["ai-workspace"],
  "permissions": [
    "core:default",
    "medios",
    "allow-workspace-roots",
    "allow-workspace-tree",
    "allow-workspace-read-document",
    "allow-workspace-open-dialog",
    "allow-workspace-activate",
    "allow-workspace-close-root",
    "allow-workspace-read-project-file",
    "allow-editor-context-get",
    "allow-kernel-catalogue",
    "allow-sample-genesis",
    "allow-analyze-source",
    "allow-shoresh-translate",
    "allow-load-local-weights",
    "allow-local-complete",
    "allow-open-desk-window",
    "allow-propose-editor-patch",
    "allow-propose-ai-desk-attachment",
    "clipboard-manager:allow-write-text"
  ]
}
