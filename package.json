{
  "name": "bara-ide-desktop",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Interfaz grafica del IDE Bara (Tauri v2 + React + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai": "node web/scripts/ai-check.mjs",
    "test:unit": "vitest run",
    "stage:kernel-host": "python src-tauri/scripts/stage-kernel-host.py --profile release",
    "patch:resources": "python src-tauri/scripts/win-gnu-recursos.py --exe ../target/release/bara-ide-desktop.exe",
    "tauri": "tauri",
    "dev:win": "node scripts/free-port-1420.mjs && tauri dev",
    "disk:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/disk-guard.ps1 -Analizar",
    "disk:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/disk-guard.ps1 -Limpiar -MinGB 10",
    "predist:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/disk-guard.ps1 -Limpiar -MinGB 8",
    "dist:windows": "python src-tauri/scripts/stage-kernel-host.py --profile release && tauri build --bundles msi,nsis"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "jsdom": "^26.1.0",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^3.2.7"
  }
}
